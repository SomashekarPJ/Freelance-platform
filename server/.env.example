# MongoDB Atlas connection (non-SRV form).
# Copy this file to server/.env and replace <username>/<password> with your Atlas
# Database Access credentials (Atlas UI > Database Access).
#
# The non-SRV form is used because this dev box has a DNS quirk: Node's c-ares
# resolver cannot resolve `mongodb+srv://` SRV records (querySrv ECONNREFUSED),
# so we use the standard `mongodb://` form listing the Atlas shard hosts explicitly.
# If your machine has working DNS, you can instead use the standard
#   mongodb+srv://<username>:<password>@freelancecluster.3nic5bo.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://<username>:<password>@ac-ysbyuuq-shard-00-00.3nic5bo.mongodb.net:27017,ac-ysbyuuq-shard-00-01.3nic5bo.mongodb.net:27017,ac-ysbyuuq-shard-00-02.3nic5bo.mongodb.net:27017/freelance-platform?replicaSet=atlas-6n3tcd-shard-0&authSource=admin&ssl=true
JWT_SECRET=your_jwt_secret
STRIPE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
